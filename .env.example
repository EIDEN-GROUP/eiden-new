# Contact form email (Nodemailer + Hostinger SMTP)
# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=contact@eiden-group.com
SMTP_PASS=your-mailbox-password
FROM_EMAIL=contact@eiden-group.com
ADMIN_EMAIL=contact@eiden-group.com

# Measurement (all optional — without them nothing loads and nothing breaks)
# GA4: Analytics → Admin → Data Streams → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=
# GTM: Tag Manager → container ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
# Clarity (heatmaps + recordings): clarity.microsoft.com → project ID
NEXT_PUBLIC_CLARITY_ID=

# Search Console verification: search.google.com/search-console → add property
# → Settings → Verification → HTML tag → paste only the content= value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
