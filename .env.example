# Contact form email (Nodemailer + Hostinger SMTP)
# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=contact@eiden-group.com
SMTP_PASS=your-mailbox-password
FROM_EMAIL=contact@eiden-group.com
ADMIN_EMAIL=contact@eiden-group.com
